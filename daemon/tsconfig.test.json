// Typechecks the tests too, so the `satisfies` SDK fixtures actually break
// when the SDK's shapes drift. Separate file because the build's rootDir is src.
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "rootDir": "." },
  // scripts/ too: smoke.ts never runs in CI, so this typecheck is the only
  // thing that notices when ClaudeSession's shape drifts out from under it.
  "include": ["src", "test", "scripts"]
}
